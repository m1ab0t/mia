{
  "name": "mia",
  "version": "2.0.0",
  "private": true,
  "description": "Mia - AI Agent",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mia": "./dist/cli.js"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "p2p:client": "tsx src/p2p/client.ts",
    "p2p:send": "tsx scripts/p2p-send.ts",
    "p2p:batch": "tsx scripts/p2p-batch.ts",
    "p2p:pipe": "tsx scripts/p2p-pipe.ts",
    "p2p:watch": "tsx scripts/p2p-watch.ts",
    "debug": "MIA_DEBUG=1 tsx --inspect src/daemon/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "link": "sudo npm link",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "keywords": [
    "agent",
    "ai",
    "cli",
    "anthropic",
    "claude"
  ],
  "author": "Cloud",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@clack/prompts": "^1.0.1",
    "@lancedb/lancedb": "^0.19.1",
    "@opencode-ai/sdk": "^1.2.10",
    "b4a": "^1.7.3",
    "cronstrue": "^3.12.0",
    "dotenv": "^17.3.1",
    "hyperdb": "^6.0.0",
    "hyperswarm": "^4.17.0",
    "node-cron": "^4.2.1",
    "onnxruntime-node": "^1.24.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "tiktoken": "^1.0.22",
    "toxe": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.0.18"
  }
}
